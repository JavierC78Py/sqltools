// English (United States) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

// The one and only template shared by all CPropTree based settings pages
// (Common::CPropTreePage). Such a page has no designed controls at all - its
// content is a CPropTree built in code - so the template is intentionally
// empty and only provides the size the sheet gives the page.
//
// The visible title does NOT come from the CAPTION below: every page assigns
// m_psp.pszTitle (PSP_USETITLE) in its constructor, and CTreePropSheet splits
// that title on "::" to build the tree of pages.
//
// A page's own help id is passed to CPropTreePage as well (the historical
// per-page IDD_xxx symbols are kept in OpenEditor/OpenEditorInc.rh for
// Help/HTMLDefines.h). Adding a new tree page therefore needs no entry here.

IDD_PROPTREE_PAGE DIALOGEX 0, 0, 450, 320
STYLE DS_SETFONT | WS_CHILD | WS_CAPTION
CAPTION "Settings"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
END


