IDR_OE_WORKBOOK_POPUP MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "&Save",                       ID_FILE_SAVE
        MENUITEM "Save &As",                    ID_FILE_SAVE_AS
        MENUITEM "Re&load",                     ID_FILE_RELOAD
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "Close Ot&hers",               ID_FILE_CLOSE_OTHERS
        MENUITEM "Clos&e All",                  ID_FILE_CLOSE_ALL
        MENUITEM SEPARATOR
        MENUITEM "Move / &Rename",              ID_FILE_RENAME
        MENUITEM SEPARATOR
        MENUITEM "Copy File Locat&ion",         ID_FILE_COPY_LOCATION
        MENUITEM "Copy File &Name",             ID_FILE_COPY_NAME
        MENUITEM SEPARATOR
        MENUITEM "File Se&ttings...",           ID_EDIT_FILE_SETTINGS
    END
END

IDR_OE_REGEXP_REPLACE_POPUP MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "\\0\tFind What Text",         ID_REGEXP_REPLACE_WHAT_FIND
        MENUITEM SEPARATOR
        MENUITEM "\\1\tTagged Expression 1",    ID_REGEXP_REPLACE_TAGEXP_1
        MENUITEM "\\2\tTagged Expression 2",    ID_REGEXP_REPLACE_TAGEXP_2
        MENUITEM "\\3\tTagged Expression 3",    ID_REGEXP_REPLACE_TAGEXP_3
        MENUITEM "\\4\tTagged Expression 4",    ID_REGEXP_REPLACE_TAGEXP_4
        MENUITEM "\\5\tTagged Expression 5",    ID_REGEXP_REPLACE_TAGEXP_5
        MENUITEM "\\6\tTagged Expression 6",    ID_REGEXP_REPLACE_TAGEXP_6
        MENUITEM "\\7\tTagged Expression 7",    ID_REGEXP_REPLACE_TAGEXP_7
        MENUITEM "\\8\tTagged Expression 8",    ID_REGEXP_REPLACE_TAGEXP_8
        MENUITEM "\\9\tTagged Expression 9",    ID_REGEXP_REPLACE_TAGEXP_9
    END
END

IDR_OE_REGEXP_FIND_POPUP MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "\\t\tTab character",          ID_REGEXP_FIND_TAB
        MENUITEM ".\tAny single character",     ID_REGEXP_FIND_ANY_CHAR
        MENUITEM "*\tZero or more",             ID_REGEXP_FIND_ZERO_OR_MORE
        MENUITEM "+\tOne or more",              ID_REGEXP_FIND_ONE_OR_MORE
        MENUITEM SEPARATOR
        MENUITEM "^\tBeginning of line",        ID_REGEXP_FIND_BOL
        MENUITEM "$\tEnd of line",              ID_REGEXP_FIND_EOL
        MENUITEM SEPARATOR
        MENUITEM "[]\tAny one character in the set", ID_REGEXP_FIND_SET
        MENUITEM "[^]\tAny one character not in the set", ID_REGEXP_FIND_NOT_SET
        MENUITEM "|\tOr",                       ID_REGEXP_FIND_OR
        MENUITEM "\\\tEscape Special Character", ID_REGEXP_FIND_ESC
        MENUITEM SEPARATOR
        MENUITEM "([a-zA-Z0-9])\tAlpha-numeric characters", ID_REGEXP_FIND_ALNUM
        MENUITEM "([a-zA-Z])\tAlphabetic characters", ID_REGEXP_FIND_ALPHA
        MENUITEM "([0-9])\tDecimal digits",     ID_REGEXP_FIND_DIGIT
        MENUITEM "([0-9a-fA-F]+)\tHexidecimal digits", ID_REGEXP_FIND_XDIGIT
        MENUITEM "([a-zA-Z_$][a-zA-Z0-9_$]*)\tC-Identifier", ID_REGEXP_FIND_IDENTIFIER
        MENUITEM "(([0-9]+\\.[0-9]*)|([0-9]*\\.[0-9]+)|([0-9]+))\tRational number", ID_REGEXP_FIND_RATIONAL
        MENUITEM "((""[^""]*"")|('[^']*'))\tQuoted string", ID_REGEXP_FIND_QUOTED
    END
END

IDR_OE_EXPLORER_POPUP MENU
BEGIN
    POPUP "Explorer"
    BEGIN
        MENUITEM "Open\tDouble Click",          ID_FPW_OPEN
        MENUITEM "Shell Open",                  ID_FPW_SHELL_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Rename",                      ID_FPW_RENAME
        MENUITEM "Delete",                      ID_FPW_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Refresh",                     ID_FPW_REFRESH
    END
END

IDR_OE_EDIT_POPUP MENU
BEGIN
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo",                       ID_EDIT_UNDO
        MENUITEM "&Redo",                       ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t",                        ID_EDIT_CUT
        MENUITEM "&Copy",                       ID_EDIT_COPY
        MENUITEM "&Paste",                      ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Select A&ll",                 ID_EDIT_SELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "&Find...",                    ID_EDIT_FIND
        MENUITEM "&Replace...",                 ID_EDIT_REPLACE
        MENUITEM "Find &next",                  ID_EDIT_FIND_NEXT
        MENUITEM "Find pre&vious",              ID_EDIT_FIND_PREVIOUS
        MENUITEM SEPARATOR
        MENUITEM "&Go To...",                   ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "&Create Template",            ID_EDIT_CREATE_TEMPLATE
        MENUITEM "&Open file under cursor",     ID_EDIT_OPENFILEUNDERCURSOR
        MENUITEM SEPARATOR
        MENUITEM "File Se&ttings...",           ID_EDIT_FILE_SETTINGS
    END
END

IDR_OE_FOLD_POPUP MENU
BEGIN
    POPUP "Outlining"
    BEGIN
        MENUITEM "&Collapse Current Region",    ID_EDIT_FOLD_COLLAPSE_CURRENT
        MENUITEM "&Expand Current Region",      ID_EDIT_FOLD_EXPAND_CURRENT
        MENUITEM "&Toggle Current Region",      ID_EDIT_FOLD_TOGGLE_CURRENT
        MENUITEM "Expand Current &Subtree",     ID_EDIT_FOLD_EXPAND_SUBTREE
        MENUITEM SEPARATOR
        MENUITEM "Collapse &All",               ID_EDIT_FOLD_COLLAPSE_ALL
        MENUITEM "E&xpand All",                 ID_EDIT_FOLD_EXPAND_ALL
        MENUITEM "Togg&le All",                 ID_EDIT_FOLD_TOGGLE_ALL
        MENUITEM SEPARATOR
        MENUITEM "Collapse to Level &1",        ID_EDIT_FOLD_COLLAPSE_LEVEL1
        MENUITEM "Collapse to Level &2",        ID_EDIT_FOLD_COLLAPSE_LEVEL2
        MENUITEM "Collapse to Level &3",        ID_EDIT_FOLD_COLLAPSE_LEVEL3
        MENUITEM SEPARATOR
        MENUITEM "&Folding Enabled",            ID_EDIT_FOLD_TOGGLE_ENABLED
    END
END

IDR_OE_DRIVERS_POPUP MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "Refresh",                     ID_FPW_REFRESH_DRIVERS
    END
END

IDR_OE_CBAR_POPUP MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "&Docking",                    ID_CBAR_DOCKING
        MENUITEM "Hide",                        ID_CBAR_HIDE
    END
END


