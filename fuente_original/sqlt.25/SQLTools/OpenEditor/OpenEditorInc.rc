    EDITTEXT        IDC_INP_VALUE,7,18,172,14,ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,37,37,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,93,37,50,14
END

IDD_OE_COLUMN_NUMBER DIALOGEX 0, 0, 177, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Insert Number"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Specify the first number to be inserted and the increment for each successive line:",IDC_STATIC,7,7,163,25
    LTEXT           "&First Number :",IDC_STATIC,7,34,46,8
    EDITTEXT        IDC_OECN_FIRST_NUMBER,101,33,69,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "&Increment :",IDC_STATIC,7,52,38,8
    EDITTEXT        IDC_OECN_INCREMENT,101,51,69,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "&Leading Zeros",IDC_OECN_LEADING_ZEROS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,71,61,10
    GROUPBOX        " Format ",IDC_STATIC,7,87,163,53
    CONTROL         "&Decimal",IDC_OECN_DECIMAL,"Button",BS_AUTORADIOBUTTON | WS_GROUP,19,103,40,10
    CONTROL         "&Hexadecimal",IDC_OECN_HEXADECIMAL,"Button",BS_AUTORADIOBUTTON,19,117,56,10
    CONTROL         "&Skip empty lines",IDC_OECN_SKIP_EMPTY_LINES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,146,67,10
    DEFPUSHBUTTON   "OK",IDOK,34,165,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,93,165,50,14
END

IDD_OE_SPLIT_LINES DIALOGEX 0, 0, 191, 159
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Split Lines"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Left margin :",IDC_STATIC,10,14,42,8
    EDITTEXT        IDC_OESL_LEFT_MARGIN,118,12,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "&Right margin :",IDC_STATIC,10,30,46,8
    EDITTEXT        IDC_OESL_RIGHT_MARGIN,118,28,40,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "&Advanced options",IDC_OESL_ADVANCED_OPTIONS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,49,73,10
    GROUPBOX        "",IDC_STATIC,4,61,183,72
    LTEXT           "&Insert a new line after :",IDC_STATIC,10,77,77,8
    EDITTEXT        IDC_OESL_INSERT_AFTER,116,75,40,14,ES_AUTOHSCROLL
    LTEXT           "char(s)",IDC_STATIC,160,77,24,8
    LTEXT           "Ignore &previous between :",IDC_STATIC,10,93,86,8
    EDITTEXT        IDC_OESL_IGNORE_PREVIOUS,116,91,40,14,ES_AUTOHSCROLL
    LTEXT           "pair(s)",IDC_STATIC,160,93,22,8
    LTEXT           "&Do not change a text between :",IDC_STATIC,10,109,104,8
    EDITTEXT        IDC_OESL_DONT_CHANGE_BETWEEN,116,107,40,14,ES_AUTOHSCROLL
    LTEXT           "pair(s)",IDC_STATIC,160,109,22,8
    DEFPUSHBUTTON   "OK",IDOK,42,139,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,100,139,50,14
END


