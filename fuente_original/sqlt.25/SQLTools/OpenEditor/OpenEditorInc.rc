    EDITTEXT        IDC_INP_VALUE,7,18,172,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,37,37,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,93,37,50,14
END

IDD_INPUT_PASSWORD DIALOGEX 0, 0, 186, 58
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Input"
FONT 8, "MS Shell Dlg", 400, 0, 0xCC
BEGIN
